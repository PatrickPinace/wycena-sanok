ErrorDocument 404 /404.html

# 1. Wymuszenie HTTPS i kanonicznej wersji domeny (bez www) w jednym kroku
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.wycena-sanok\.pl$ [NC]
RewriteRule ^(.*)$ https://wycena-sanok.pl/$1 [R=301,L]

# 2. Przekierowania ze starej struktury strony
RewriteRule ^index\.html$ /? [R=301,L]
RewriteRule ^wycena-nieruchomosci-oferta\.html$ /#oferta [R=301,L,NE]
RewriteRule ^wycena-nieruchomosci-o[Ff]irmie\.html$ /#o-firmie [R=301,L,NE]
RewriteRule ^wycena-nieruchomosci-cennik\.html$ /#cennik [R=301,L,NE]
RewriteRule ^wycena-nieruchomosci-kontakt\.html$ /#kontakt [R=301,L,NE]

# 3. Wymuszenie trailing slash na katalogach (pomija pliki i już poprawne adresy)
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !(.*)/$
RewriteRule ^(.*)$ /$1/ [R=301,L]
