---
import SectionHeading from './SectionHeading.astro';

const items = [
  'Działki niezabudowane',
  'Działki zabudowane budynkami mieszkalnymi',
  'Lokale mieszkalne, także w budowie',
  'Spółdzielcze własnościowe prawo do lokalu',
  'Lokale użytkowe',
  'Nieruchomości komercyjne',
  'Garaże',
  'Kamienice',
];
---

<section id="oferta" class="oferta">
  <div class="oferta-grid">
    <SectionHeading
      title="Jakie nieruchomości wyceniam"
      description="Szacuję wartość nieruchomości wszystkich podstawowych typów występujących na rynku sanockim."
    />
    <ul class="items">
      {items.map((item) => <li>{item}</li>)}
    </ul>
  </div>
</section>

<style>
  .oferta {
    max-width: 1180px;
    margin: 0 auto;
    padding: 85px 32px;
  }

  .oferta-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
    align-items: flex-start;
  }

  .items {
    flex: 1 1 420px;
    min-width: 0;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 0 40px;
  }

  .items li {
    padding: 18px 0;
    border-bottom: 1px solid var(--color-border-soft);
    font-size: 17px;
    letter-spacing: -0.005em;
    color: var(--color-ink-soft);
    transition:
      color 0.15s ease,
      padding-left 0.15s ease;
  }

  .items li:hover {
    color: var(--color-primary);
    padding-left: 6px;
  }
</style>
