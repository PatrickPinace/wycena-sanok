---
import SectionHeading from './SectionHeading.astro';

const grupy = [
  {
    label: 'Zawsze',
    items: ['Numer księgi wieczystej lub odpis KW', 'Wypis z rejestru gruntów', 'Dokument potwierdzający tytuł prawny'],
  },
  {
    label: 'Działka',
    items: ['Wyrys z mapy ewidencyjnej', 'Wypis z miejscowego planu zagospodarowania lub decyzja o warunkach zabudowy'],
  },
  {
    label: 'Dom',
    items: ['Projekt lub inwentaryzacja budynku', 'Pozwolenie na budowę, dziennik budowy', 'Zawiadomienie o zakończeniu budowy'],
  },
  {
    label: 'Mieszkanie',
    items: ['Akt notarialny lub zaświadczenie ze spółdzielni', 'Rzut lokalu, powierzchnia użytkowa', 'Umowa przedwstępna — przy wycenie do kredytu'],
  },
];
---

<section class="dokumenty-band">
  <div class="dokumenty">
    <div class="dokumenty-grid">
      <SectionHeading
        title="Jakie dokumenty są potrzebne"
        description="Poniżej typowy zestaw. Ostateczną listę ustalam przy pierwszym kontakcie — zależy od rodzaju nieruchomości i celu wyceny."
      />
      <div class="grupy">
        {
          grupy.map((grupa) => (
            <div>
              <h3>{grupa.label}</h3>
              <ul>
                {grupa.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .dokumenty-band {
    background: var(--color-bg-alt);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .dokumenty {
    max-width: 1180px;
    margin: 0 auto;
    padding: 104px 32px;
  }

  .dokumenty-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
    align-items: flex-start;
  }

  .grupy {
    flex: 1 1 420px;
    min-width: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 40px;
  }

  .grupy h3 {
    margin: 0 0 14px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .grupy ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 10px;
    font-size: 16px;
    line-height: 1.55;
    color: var(--color-ink-soft);
  }
</style>
