---
interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<div class="section-heading">
  <span class="rule" aria-hidden="true"></span>
  <h2>{title}</h2>
  {description && <p class="description">{description}</p>}
</div>

<style>
  .section-heading {
    flex: 0 1 400px;
    min-width: 260px;
  }

  .rule {
    display: block;
    width: 40px;
    height: 2px;
    margin-bottom: 22px;
    background: var(--color-primary);
  }

  h2 {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(2.1rem, 4.1vw, 3.4rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    max-width: 16ch;
  }

  .description {
    margin: 22px 0 0;
    max-width: 46ch;
    font-size: 17px;
    line-height: 1.65;
    color: var(--color-text);
  }
</style>
