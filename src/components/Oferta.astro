---
import SectionHeading from './SectionHeading.astro';
import { withBase } from '../lib/url';

const items = [
  { label: 'Działki niezabudowane', href: '/wycena-dzialki-sanok/' },
  { label: 'Działki zabudowane budynkami mieszkalnymi', href: '/wycena-domu-sanok/' },
  { label: 'Lokale mieszkalne, także w budowie', href: '/wycena-mieszkania-sanok/' },
  { label: 'Spółdzielcze własnościowe prawo do lokalu', href: '/wycena-mieszkania-sanok/' },
  { label: 'Lokale użytkowe', href: '/wycena-lokalu-uzytkowego-sanok/' },
  { label: 'Nieruchomości komercyjne', href: '/wycena-lokalu-uzytkowego-sanok/' },
  { label: 'Garaże', href: '/wycena-lokalu-uzytkowego-sanok/' },
  { label: 'Kamienice', href: '/wycena-lokalu-uzytkowego-sanok/' },
];
---

<section id="oferta" class="oferta">
  <div class="oferta-grid">
    <SectionHeading
      title="Jakie nieruchomości wyceniam"
      description="Szacuję wartość nieruchomości wszystkich podstawowych typów występujących na rynku sanockim."
    />
    <ul class="items">
      {
        items.map((item) => (
          <li>
            <a href={withBase(item.href)}>
              {item.label}
              <span class="arrow" aria-hidden="true">
                →
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .oferta {
    max-width: 1180px;
    margin: 0 auto;
    padding: 85px 32px;
  }

  .oferta-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
    align-items: flex-start;
  }

  .items {
    flex: 1 1 420px;
    min-width: 0;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 0 40px;
  }

  .items li {
    border-bottom: 1px solid var(--color-border-soft);
  }

  .items a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 0;
    font-size: 17px;
    letter-spacing: -0.005em;
    color: var(--color-ink-soft);
    transition:
      color 0.15s ease,
      padding-left 0.15s ease;
  }

  .items a:hover {
    color: var(--color-primary);
    padding-left: 6px;
  }

  .arrow {
    flex: none;
    transition: transform 0.15s ease;
  }

  .items a:hover .arrow {
    transform: translateX(3px);
  }
</style>
