---
import { business } from '../data/business';
---

<footer class="site-footer">
  <div class="inner">
    <p>Wycena nieruchomości Sanok · {business.name} · NIP&nbsp;{business.nip}</p>
    <p>
      <a href={business.mapsDirectionsUrl} target="_blank" rel="noopener">{business.street}, {business.postalCode} {business.city}</a> · tel. <a href={business.phoneHref}>{business.phone}</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-navy-deep);
    color: #8fa6bc;
  }

  .inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: 36px 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 20px 40px;
    justify-content: space-between;
    font-size: 14px;
    line-height: 1.6;
  }

  .inner p {
    margin: 0;
  }

  .inner a {
    color: #8fa6bc;
    border-bottom: 1px solid #45658a;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }

  .inner a:hover {
    color: #fff;
    border-color: #fff;
  }

  @media (max-width: 720px) {
    .site-footer {
      padding-bottom: 72px;
    }
  }
</style>
