---
import { business } from '../data/business';
---

<header class="site-header">
  <div class="inner">
    <a href="/" class="brand">
      <span class="brand-name">{business.name}</span>
      <span class="brand-role">{business.title} · {business.city}</span>
    </a>
    <nav aria-label="Główne">
      <a href="#oferta">Oferta</a>
      <a href="#o-firmie">O firmie</a>
      <a href="#cennik">Cennik</a>
      <a href="#pytania">Pytania</a>
      <a href="#kontakt">Kontakt</a>
      <a id="nav-telefon" href={business.phoneHref} class="phone-btn">{business.phone}</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(251, 250, 248, 0.94);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-border);
  }

  .inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    min-height: 76px;
  }

  .brand {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px 0;
  }

  .brand-name {
    font-family: var(--font-serif);
    font-size: 21px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }

  .brand-role {
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  nav {
    display: flex;
    align-items: center;
    gap: 30px;
    flex-wrap: wrap;
    padding: 8px 0;
  }

  nav > a {
    font-size: 14px;
    color: #3c4248;
    padding: 6px 0;
    border-bottom: 1px solid transparent;
  }

  nav > a:hover {
    color: var(--color-primary);
    border-bottom-color: var(--color-primary);
  }

  .phone-btn {
    font-weight: 500;
    color: var(--color-bg) !important;
    background: var(--color-primary);
    padding: 11px 20px;
    border-radius: 6px;
    border-bottom: none !important;
  }

  .phone-btn:hover {
    background: var(--color-primary-hover);
  }

  @media (max-width: 720px) {
    #nav-telefon {
      display: none;
    }
  }
</style>
