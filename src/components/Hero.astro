---
import { business } from '../data/business';
---

<section class="hero">
  <div class="hero-grid">
    <div class="hero-main">
      <p class="eyebrow">Uprawnienia zawodowe nr {business.licenseNumber} · od {business.foundedYear} roku</p>
      <h1>Wycena nieruchomości Sanok</h1>
      <p class="lead">
        Operaty szacunkowe i wyceny nieruchomości w Sanoku i na terenie Podkarpacia. Mieszkania, domy,
        działki, lokale i nieruchomości komercyjne.
      </p>
      <div class="cta-row">
        <a href={business.phoneHref} class="cta-primary">Zadzwoń: {business.phone}</a>
        <a href="#oferta" class="cta-secondary">Zakres usług</a>
      </div>
      <p class="note">Wyceny dla banków, sądów, urzędów, kancelarii notarialnych i klientów indywidualnych.</p>
    </div>

    <aside class="hero-card">
      <p class="hero-card-label">Kontakt bezpośredni</p>
      <a href={business.phoneHref} class="hero-card-phone">{business.phone}</a>
      <a href={business.phoneSecondaryHref} class="hero-card-phone-secondary">{business.phoneSecondary}</a>
      <div class="divider"></div>
      <dl class="hero-card-details">
        <div>
          <dt>Godziny</dt>
          <dd>{business.hours}</dd>
        </div>
        <div>
          <dt>Biuro</dt>
          <dd>{business.street}, {business.postalCode} {business.city}</dd>
        </div>
        <div>
          <dt>E-mail</dt>
          <dd><a href={`mailto:${business.email}`}>{business.email}</a></dd>
        </div>
      </dl>
    </aside>
  </div>
</section>

<style>
  .hero {
    max-width: 1180px;
    margin: 0 auto;
    padding: 100px 32px 76px;
  }

  .hero-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 64px;
    align-items: flex-start;
  }

  .hero-main {
    flex: 1 1 480px;
    min-width: 0;
  }

  .eyebrow {
    margin: 0 0 30px;
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  h1 {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(2.9rem, 6vw, 4.5rem);
    line-height: 1.03;
    letter-spacing: -0.022em;
    color: var(--color-ink);
    text-wrap: balance;
  }

  .lead {
    margin: 30px 0 0;
    max-width: 44ch;
    font-size: 19px;
    line-height: 1.6;
    color: var(--color-text);
    text-wrap: pretty;
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 40px;
  }

  .cta-primary,
  .cta-secondary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 16px;
    font-weight: 500;
    padding: 16px 28px;
    border-radius: 6px;
    min-height: 52px;
  }

  .cta-primary {
    background: var(--color-primary);
    color: var(--color-bg);
  }

  .cta-primary:hover {
    background: var(--color-primary-hover);
  }

  .cta-secondary {
    border: 1px solid #c9c3b7;
  }

  .cta-secondary:hover {
    border-color: var(--color-primary);
    background: #f1eee8;
  }

  .note {
    margin: 34px 0 0;
    max-width: 62ch;
    font-size: 15px;
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  .hero-card {
    flex: 0 1 340px;
    min-width: 260px;
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 32px;
  }

  .hero-card-label {
    margin: 0 0 22px;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .hero-card-phone {
    display: block;
    font-family: var(--font-serif);
    font-size: 32px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-primary);
  }

  .hero-card-phone-secondary {
    display: block;
    margin-top: 6px;
    font-size: 15px;
    color: #4a5058;
  }

  .divider {
    height: 1px;
    background: #e0dbd1;
    margin: 24px 0;
  }

  .hero-card-details {
    margin: 0;
    display: grid;
    gap: 16px;
    font-size: 15px;
    line-height: 1.6;
  }

  .hero-card-details dt {
    color: var(--color-text-muted);
    margin-bottom: 3px;
    font-size: 14px;
  }

  .hero-card-details dd {
    margin: 0;
    color: var(--color-ink-soft);
  }
</style>
