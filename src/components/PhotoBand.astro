---
import { Image } from 'astro:assets';
import domImage from '../assets/dom.jpg';
---

<figure class="photo-band">
  <Image
    src={domImage}
    alt="Budynek mieszkalny — przykład nieruchomości podlegającej wycenie"
    loading="lazy"
    widths={[640, 1024, 1600, 2000]}
    sizes="100vw"
  />
</figure>

<style>
  .photo-band {
    margin: 0;
    border-bottom: 1px solid var(--color-border);
  }

  .photo-band :global(img) {
    display: block;
    width: 100%;
    height: clamp(200px, 28vw, 340px);
    object-fit: cover;
    filter: saturate(0.5) contrast(1.02);
  }
</style>
