---
import { business } from '../data/business';

const stats = [
  { value: String(business.foundedYear), label: 'Rok rozpoczęcia działalności' },
  { value: `nr ${business.licenseNumber}`, label: 'Uprawnienia rzeczoznawcy majątkowego' },
  { value: 'Podkarpacie', label: 'Zasięg działania, w szczególności Sanok i okolice' },
  { value: 'PFSRM', label: 'Standardy zawodowe, według których powstaje każdy operat' },
];
---

<div class="stats-band">
  <div class="stats-inner">
    <div class="stats-row">
      {
        stats.map((stat) => (
          <div class="stat">
            <p class="stat-value">{stat.value}</p>
            <p class="stat-label">{stat.label}</p>
          </div>
        ))
      }
    </div>
  </div>
</div>

<style>
  .stats-band {
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .stats-inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 32px;
  }

  .stats-row {
    display: flex;
    flex-wrap: wrap;
  }

  .stat {
    flex: 1 1 200px;
    padding: 30px 28px;
  }

  .stat:first-child {
    padding-left: 0;
  }

  .stat:last-child {
    padding-right: 0;
  }

  .stat-value {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 28px;
    font-weight: 600;
    font-variant-numeric: lining-nums;
    letter-spacing: -0.01em;
    color: var(--color-primary);
    line-height: 1;
  }

  .stat-label {
    margin: 8px 0 0;
    font-size: 14px;
    line-height: 1.55;
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .stats-row {
      flex-direction: column;
      flex-wrap: nowrap;
    }

    .stat {
      padding: 22px 0;
      border-bottom: 1px solid var(--color-border-soft);
    }

    .stat:first-child {
      padding-top: 0;
    }

    .stat:last-child {
      padding-bottom: 22px;
      border-bottom: none;
    }
  }
</style>
