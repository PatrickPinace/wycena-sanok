---
import { business } from '../data/business';
import { withBase } from '../lib/url';

interface Props {
  isHomePage?: boolean;
}

const { isHomePage = true } = Astro.props;
const prefix = isHomePage ? '' : '/';

const navItems = [
  { id: 'oferta', label: 'Oferta' },
  { id: 'proces', label: 'Proces' },
  { id: 'o-firmie', label: 'O firmie' },
  { id: 'cennik', label: 'Koszt wyceny' },
  { id: 'pytania', label: 'Pytania' },
  { id: 'kontakt', label: 'Kontakt' },
];
---

<header class="site-header">
  <div class="inner">
    <a href={withBase('/')} class="brand">
      <span class="brand-name">{business.name}</span>
      <span class="brand-role">{business.title} · {business.city}</span>
    </a>
    <nav aria-label="Główne">
      {
        navItems.map((item) => (
          <a href={withBase(`${prefix}#${item.id}`)} data-nav-link data-target-id={item.id}>
            {item.label}
          </a>
        ))
      }
      <a id="nav-telefon" href={business.phoneHref} class="phone-btn">{business.phone}</a>
    </nav>
  </div>
</header>

{
  isHomePage && (
    <script>
      const navLinks = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');
      const sections = Array.from(navLinks)
        .map((link) => document.getElementById(link.dataset.targetId ?? ''))
        .filter((el): el is HTMLElement => el !== null);

      const setActive = (id: string) => {
        navLinks.forEach((link) => {
          link.classList.toggle('active', link.dataset.targetId === id);
        });
      };

      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries.filter((entry) => entry.isIntersecting);
          if (visible.length > 0) {
            const topmost = visible.reduce((a, b) =>
              a.boundingClientRect.top < b.boundingClientRect.top ? a : b,
            );
            setActive(topmost.target.id);
          }
        },
        { rootMargin: '-40% 0px -55% 0px', threshold: 0 },
      );

      sections.forEach((section) => observer.observe(section));
    </script>
  )
}

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(251, 250, 248, 0.94);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-border);
  }

  .inner {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
    min-height: 76px;
  }

  .brand {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px 0;
  }

  .brand-name {
    font-family: var(--font-serif);
    font-size: 21px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }

  .brand-role {
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  nav {
    display: flex;
    align-items: center;
    gap: 30px;
    flex-wrap: wrap;
    padding: 8px 0;
  }

  nav > a {
    position: relative;
    font-size: 14px;
    color: #3c4248;
  }

  nav > a:not(.phone-btn) {
    padding: 6px 0;
  }

  nav > a:not(.phone-btn)::after {
    content: '';
    position: absolute;
    left: 0;
    right: 100%;
    bottom: 0;
    height: 1px;
    background: var(--color-primary);
    transition: right 0.2s ease;
  }

  nav > a:not(.phone-btn):hover,
  nav > a:not(.phone-btn).active {
    color: var(--color-primary);
  }

  nav > a:not(.phone-btn):hover::after,
  nav > a:not(.phone-btn).active::after {
    right: 0;
  }

  .phone-btn {
    font-weight: 500;
    color: var(--color-bg) !important;
    background: var(--color-primary);
    padding: 17px 26px;
    border-radius: 8px;
    font-variant-numeric: lining-nums;
    transition: background-color 0.15s ease;
  }

  .phone-btn:hover {
    background: var(--color-primary-hover);
  }

  @media (max-width: 720px) {
    #nav-telefon {
      display: none;
    }

    nav a:not(.phone-btn) {
      padding: 12px 0;
    }
  }
</style>
