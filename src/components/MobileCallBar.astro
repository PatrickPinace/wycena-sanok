---
import { business } from '../data/business';
---

<a id="pasek-telefon" href={business.phoneHref} class="mobile-call-bar">
  <svg width="18" height="18" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true">
    <path
      d="M222.37 158.46l-47.11-21.11-.13-.06a16 16 0 00-15.17 1.4 8.12 8.12 0 00-.75.56L134.87 160c-15.42-7.49-31.34-23.29-38.83-38.51l20.78-24.71c.2-.25.39-.5.57-.77a16 16 0 001.32-15.06v-.12L97.54 33.64a16 16 0 00-16.62-9.52A56.26 56.26 0 0032 80c0 79.4 64.6 144 144 144a56.26 56.26 0 0055.88-48.92 16 16 0 00-9.51-16.62z"
    ></path>
  </svg>
  Zadzwoń: {business.phone}
</a>

<style>
  .mobile-call-bar {
    display: none;
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 40;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: var(--color-primary);
    color: var(--color-bg) !important;
    font-size: 17px;
    font-weight: 500;
    min-height: 60px;
    padding: 0 20px;
    border-top: 1px solid #2e4c6b;
  }

  .mobile-call-bar:hover {
    background: var(--color-primary-hover);
  }

  @media (max-width: 720px) {
    .mobile-call-bar {
      display: flex;
    }
  }
</style>
