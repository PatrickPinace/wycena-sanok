---
import { business } from '../data/business';

const query = encodeURIComponent(`${business.street}, ${business.postalCode} ${business.city}`);
const mapSrc = `https://maps.google.com/maps?q=${query}&z=16&output=embed`;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Mapa — {business.street}, {business.city}</title>
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <iframe
      title={`Mapa — ${business.street}, ${business.city}`}
      src={mapSrc}
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
    ></iframe>
  </body>
</html>

<style is:global>
  html,
  body {
    margin: 0;
    height: 100%;
  }

  iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
