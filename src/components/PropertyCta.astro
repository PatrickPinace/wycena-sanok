---
import { business } from '../data/business';

interface Props {
  ctaText: string;
}

const { ctaText } = Astro.props;
---

<section class="cta">
  <div class="cta-inner">
    <span class="rule" aria-hidden="true"></span>
    <h2>Porozmawiajmy o wycenie</h2>
    <p class="lead">
      Zadzwoń lub napisz — na podstawie rodzaju nieruchomości, adresu i celu wyceny podam cenę i termin
      realizacji {ctaText}.
    </p>
    <div class="cta-row">
      <a href={business.phoneHref} class="cta-primary">Zadzwoń: {business.phone}</a>
      <a href="/#kontakt" class="cta-secondary">Pełne dane kontaktowe</a>
    </div>
  </div>
</section>

<style>
  .cta {
    background: var(--color-primary);
    color: #f2f4f7;
  }

  .cta-inner {
    max-width: 720px;
    margin: 0 auto;
    padding: 85px 32px;
    text-align: center;
  }

  .rule {
    display: inline-block;
    width: 40px;
    height: 2px;
    margin-bottom: 22px;
    background: #5c7894;
  }

  h2 {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(2.1rem, 3.8vw, 3rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: #fff;
  }

  .lead {
    margin: 22px auto 0;
    max-width: 46ch;
    font-size: 17px;
    line-height: 1.7;
    color: #c9d6e2;
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    margin-top: 36px;
  }

  .cta-primary,
  .cta-secondary {
    display: inline-flex;
    align-items: center;
    font-size: 16px;
    font-weight: 500;
    padding: 16px 28px;
    border-radius: 6px;
    min-height: 52px;
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease,
      transform 0.15s ease;
  }

  .cta-primary {
    background: var(--color-bg);
    color: var(--color-primary) !important;
    font-variant-numeric: lining-nums;
  }

  .cta-primary:hover {
    background: #fff;
    transform: translateY(-1px);
  }

  .cta-secondary {
    color: #fff !important;
    border: 1px solid #45658a;
  }

  .cta-secondary:hover {
    border-color: #fff;
    background: #1a3a5c;
    transform: translateY(-1px);
  }
</style>
